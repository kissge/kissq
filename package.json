{
	"name": "kissq-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"api:dev": "pnpm --filter kissq-companion run dev",
		"dev": "pnpm --parallel run dev",
		"format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write . && stylelint --fix **/*.svelte",
		"format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
		"lint": "oxlint && stylelint **/*.svelte",
		"web:build": "pnpm --filter kissq run build",
		"web:check": "pnpm --filter kissq run check",
		"web:dev": "pnpm --filter kissq run dev"
	},
	"devDependencies": {
		"@himynameisdave/oxfmt-config": "^1.1.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.27.0",
		"postcss-html": "^2.0.0",
		"stylelint": "^18.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-recess-order": "^7.10.0",
		"stylelint-order": "^8.1.3"
	},
	"packageManager": "pnpm@12.4.2"
}
