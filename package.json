{
	"name": "kissq-workspace",
	"private": true,
	"scripts": {
		"format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --write .",
		"format:check": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore --check .",
		"lint": "oxlint .",
		"web:dev": "pnpm --filter kissq run dev",
		"web:build": "pnpm --filter kissq run build",
		"web:check": "pnpm --filter kissq run check"
	},
	"devDependencies": {
		"oxfmt": "^0.74.0",
		"oxlint": "^1.27.0"
	},
	"packageManager": "pnpm@12.4.2"
}
